{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "redactor",
	"main": "./src/index.ts",
	"compatibility_date": "2026-10-12",
	"compatibility_flags": ["nodejs_compat"],
	// The published quizzes are built into the Worker (scripts/content.ts): deploying publishes them.
	"build": { "command": "npm run -s content", "watch_dir": "quizzes" },
	// Their photos, served only through the Content entrypoint (src/index.ts): every request runs
	// the Worker first, and without the token it answers 404.
	"assets": { "directory": "./quizzes/photos", "binding": "ASSETS", "run_worker_first": true },
	"workers_dev": false,
	"routes": [{ "pattern": "redactor.advox.ro", "custom_domain": true }],
	"preview_urls": false,
	// Created with --jurisdiction=eu, like the site's: the data stays in the European Union.
	"d1_databases": [
		{ "binding": "DB", "database_name": "redactor", "database_id": "f76a670d-7db1-43a6-8d3f-c61f536381c3", "migrations_dir": "migrations" }
	],
	"ai": { "binding": "AI" },
	// Times in UTC (src/index.ts says what each one runs).
	"triggers": {
		"crons": ["*/30 * * * *", "0 2 * * *"]
	},
	"vars": {
		// The site repository: what advox.ro has published (sync.ts).
		"SITE_REPO": "advox-ro/site"
	},
	"observability": { "enabled": true }
}
