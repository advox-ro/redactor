{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "redactor",
	"main": "./src/index.ts",
	"compatibility_date": "2026-10-12",
	"compatibility_flags": ["nodejs_compat"],
	// The published content (pages, wiki, question pool) is built into the Worker
	// (scripts/content.ts): deploying publishes it.
	"build": { "command": "npm run -s content", "watch_dir": ["pages", "quizzes", "wiki", "questions"] },
	// Their photos, served only through the Content entrypoint (src/index.ts): every request runs
	// the Worker first, and without the token it answers 404.
	"assets": { "directory": "./pages/photos", "binding": "ASSETS", "run_worker_first": true },
	"workers_dev": false,
	"routes": [{ "pattern": "redactor.advox.ro", "custom_domain": true }],
	"preview_urls": false,
	// Created with --jurisdiction=eu, like the site's: the data stays in the European Union.
	"d1_databases": [
		{ "binding": "DB", "database_name": "redactor", "database_id": "f76a670d-7db1-43a6-8d3f-c61f536381c3", "migrations_dir": "migrations" }
	],
	"ai": { "binding": "AI" },
	// A headless browser, to photograph the editor's pages before they are merged (src/preview.ts).
	"browser": { "binding": "BROWSER" },
	// Times in UTC (src/index.ts says what each one runs).
	"triggers": {
		"crons": ["*/30 * * * *", "0 2 * * *"]
	},
	"observability": { "enabled": true }
}
